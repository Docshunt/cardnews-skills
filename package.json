{
  "name": "@docshunt/cardnews-skills",
  "version": "0.1.0",
  "description": "Codex-ready Korean editorial card-news and presentation skills.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Docshunt/cardnews-skills.git"
  },
  "bugs": {
    "url": "https://github.com/Docshunt/cardnews-skills/issues"
  },
  "homepage": "https://github.com/Docshunt/cardnews-skills#readme",
  "files": [
    ".agents/skills",
    "AGENTS.md",
    "LICENSE",
    "README.md",
    "scripts",
    "templates"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node .agents/skills/cardnews-writing/scripts/validate-cardnews.mjs --self-test && node .agents/skills/cardnews-writing/scripts/check-cardnews-quality.mjs --self-test && npm run test:cardnews-skill && npm run test:cardnews-system",
    "check:quality": "node .agents/skills/cardnews-writing/scripts/check-cardnews-quality.mjs",
    "test:cardnews-skill": "node scripts/validate-cardnews-skill.mjs",
    "test:cardnews-system": "node scripts/test-cardnews-system.mjs",
    "test:cardnews-build": "node scripts/test-cardnews-batch-build.mjs",
    "pack:check": "npm pack --dry-run --cache /tmp/cardnews-skills-npm-cache"
  },
  "npmSkills": {
    "publish": {
      "source": ".agents/skills",
      "export": ["blog-writing", "cardnews-writing", "presentation-writing"]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
